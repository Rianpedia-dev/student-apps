# ===================================================================
# Production Environment Configuration Template — Al-Azhar Cairo Palembang
# Merujuk ke plan-update-.md Bagian 2.5 & Fase 1 Task 1.5
# Salin file ini menjadi .env.production saat deploy ke VPS / Server Production
# ===================================================================

NODE_ENV=production

# Database MySQL / MariaDB (Sesuaikan user, password kuat, dan host server)
DATABASE_URL="mysql://app_user:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:3306/sisfo_alazhar"
DB_CONNECTION_LIMIT=30
DB_SSL_REJECT_UNAUTHORIZED="true"

# Secret Key untuk Enkripsi JWT HS256 Sesi & Socket Token (WAJIB minimal 32 karakter acak!)
# Generate dengan: openssl rand -base64 48
AUTH_SECRET="GENERATE_A_COMPLEX_64_CHARACTER_RANDOM_STRING_FOR_PRODUCTION_KEY!!"

# Mode Demo (WAJIB false di production untuk mematikan semua fallback akun demo)
ENABLE_DEMO_MODE="false"

# Rate Limiting
RATE_LIMIT_ENABLED="true"

# WebSocket Socket.IO Server Configuration
SOCKET_PORT=3001
SOCKET_CORS_ORIGIN="https://sisfo.alazhar-palembang.sch.id"

# Redis Cache & Rate Limiting (Opsional / Direkomendasikan untuk cluster)
REDIS_URL="redis://127.0.0.1:6379"

# Daily.co Video Call Integration (Server-side API key)
DAILY_API_KEY=""
