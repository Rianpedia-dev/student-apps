# .env per PRD Section 11

# ==============================================================================
# DATABASE CONFIGURATION
# Aktifkan salah satu DATABASE_URL di bawah ini (beri tanda # untuk menonaktifkan)
# ==============================================================================

# 1. TiDB Cloud (Production / Remote Database) [AKTIF]
DATABASE_URL="mysql://2jsdE8KwwSrScdG.root:OuScPAxSg3m0d7Vb@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/student-app?sslaccept=strict"

# 2. Local Laragon MySQL (User: root, Password: kosong) [NON-AKTIF]
# DATABASE_URL="mysql://root:@localhost:3306/student-app"


# ============================================
# BETTER AUTH
# ============================================
BETTER_AUTH_SECRET="alazhar-cairo-secret-key-min-32-chars-2026"
BETTER_AUTH_URL="http://localhost:3000"

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_NAME="Student Apps"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=10485760  # 10MB in bytes

# ============================================
# REAL-TIME (Socket.io)
# ============================================
# Port tempat server socket berjalan (server/socket-server.cjs).
SOCKET_PORT=3001

# Origin yang diizinkan terhubung ke server socket (CORS), pisahkan dengan koma.
# Production: set ke domain aplikasi, mis. https://sisfoalazhar.sch.id
# Development: biarkan "*".
SOCKET_CORS_ORIGIN="*"

# URL dasar yang dipakai browser untuk connects ke Socket.IO.
# - KOSONGKAN untuk production bila reverse-proxy (nginx/IIS) meneruskan
#   path /socket.io ke service socket pada origin yang sama (didukung otomatis).
# - Untuk `next dev` di mana aplikasi di :3000 & socket di :3001, hook sudah
#   otomatis memakai http://localhost:3001 — tidak perlu diset.
# - Set manual hanya bila topologi Anda khusus, mis. via tunnel/HTTPS:
# NEXT_PUBLIC_SOCKET_URL="https://socket.domain-anda.com"
#
# CATATAN: AUTH_SECRET (di atas) HARUS sama dengan yang dipakai socket server,
# karena capability token (/api/socket-token) ditandatangani & diverifikasi
# memakai secret tersebut.

