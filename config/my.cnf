# ===================================================================
# MySQL / MariaDB Server Production Tuning Configuration
# Student Apps Al-Azhar Cairo Palembang (1500+ Concurrent Users)
# Merujuk ke plan-update-.md Bagian 3.1.4 & Fase 2 Task 2.7
# ===================================================================

[mysqld]
# Network & Connections
max_connections = 300
max_connect_errors = 1000
connect_timeout = 10
wait_timeout = 600
interactive_timeout = 600
max_allowed_packet = 64M

# Character Set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# InnoDB Memory & Buffer Tuning (Optimal untuk VPS 4GB-8GB RAM)
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 2
innodb_log_buffer_size = 32M
innodb_log_file_size = 256M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_open_files = 4000
innodb_io_capacity = 1000
innodb_io_capacity_max = 2000

# Thread & Table Caches
thread_cache_size = 50
table_open_cache = 2000
table_definition_cache = 1400

# Temporary Tables in Memory
tmp_table_size = 64M
max_heap_table_size = 64M

# Slow Query Logging (Deteksi query lambat untuk optimasi berkelanjutan)
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow-query.log
long_query_time = 2
log_queries_not_using_indexes = 0

[client]
default-character-set = utf8mb4
